DATABASE_URL=postgresql://questionnaire:change-me@localhost:5432/questionnaire
APP_URL=http://localhost:3000
# Optional OpenAI-compatible endpoint. HTTPS is required in production.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Required only when configuring outbound webhooks; use at least 32 random characters.
WEBHOOK_SECRET=
WEBHOOK_ALLOWED_URLS=
# Compose only. Match this password in DATABASE_URL; inside Compose the host is db.
POSTGRES_PASSWORD=
