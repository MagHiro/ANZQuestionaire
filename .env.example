DATABASE_URL=postgresql://questionnaire:change-me@localhost:5432/questionnaire
APP_URL=http://localhost:3000
# Optional OpenAI-compatible endpoint. HTTPS is required in production.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Required for saving API keys through the admin UI: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=
# Required only when configuring outbound webhooks; use at least 32 random characters.
WEBHOOK_SECRET=
WEBHOOK_ALLOWED_URLS=
# Compose only. Match this password in DATABASE_URL; inside Compose the host is db.
POSTGRES_PASSWORD=
# Paid questionnaires and email (configure before enabling paid releases)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESPONSE_ACCESS_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
